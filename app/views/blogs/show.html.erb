<p style="color: green"><%= notice %></p>

<div class="container py-4 page-content-bg">

  <h1 class="mb-2"><%= @blog.title %></h1>

  <% if @blog.published_at.present? %>
    <p class="lead text-muted"><%= @blog.published_at.strftime("%B %d, %Y") %></p>
  <% end %>

  <hr class="my-4">

  <div class="row justify-content-center align-items-start g-5">

    <div class="col-lg-6">
      <% if @blog.image_filename.present? %>
        <%= image_tag @blog.image_filename, class: "img-fluid rounded shadow-sm w-100" %>
      <% end %>
    </div>

    <div class="col-lg-6">

      <% if @blog.headingone.present? %>
        <h2 class="mb-2"><%= @blog.headingone %></h2>
      <% end %>
      <div class="fs-5" style="white-space: pre-line;"><%= @blog.bodyone %></div>

      <% if @blog.headingtwo.present? %>
        <h2 class="mb-2 mt-4"><%= @blog.headingtwo %></h2>
      <% end %>
      <div class="fs-5" style="white-space: pre-line;"><%= @blog.bodytwo %></div>

    </div>

  </div>

  <% if @blog.headingthree.present? || @blog.bodythree.present? %>
    <div class="row justify-content-center mt-4">
      <div class="col-lg-12">
        <% if @blog.headingthree.present? %>
          <h2 class="mb-2"><%= @blog.headingthree %></h2>
        <% end %>
        <div class="fs-5" style="white-space: pre-line;"><%= @blog.bodythree %></div>
      </div>
    </div>
  <% end %>

  <div class="d-flex gap-2 mt-5">
    <%= link_to "Back to Blogs", blogs_path, class: "btn btn-primary" %>

    <% if can? :edit, @blog %>
      <%= link_to "Edit", edit_blog_path(@blog), class: "btn btn-primary" %>
    <% end %>

    <% if can? :destroy, @blog %>
      <%= button_to "Delete", @blog, method: :delete, class: "btn btn-outline-danger ms-auto", form: { data: { turbo_confirm: "Are you sure?" } } %>
    <% end %>
  </div>

</div>